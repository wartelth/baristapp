# ── Required ──────────────────────────────────────────────────────────
PORT=3001

# At least one LLM provider key is required:
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ── LLM Configuration ────────────────────────────────────────────────
# Provider: "claude" (default) or "openai"
LLM_PROVIDER=claude

# OpenAI model names (used when LLM_PROVIDER=openai or for aider)
OPENAI_CODING_MODEL=gpt-4.1
OPENAI_SMALL_MODEL=gpt-4.1-mini

# ── Supabase (optional — cloud storage, sharing, billing) ────────────
# Without Supabase the server runs in local-only mode (specs saved in memory).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# ── Aider Integration (optional) ─────────────────────────────────────
# Set AGENT_EXECUTOR_MODE=aider to use aider CLI for generation.
# Default is "native" which uses the built-in LLM worker.
AGENT_EXECUTOR_MODE=native

# Aider-specific settings (only used when AGENT_EXECUTOR_MODE=aider)
# AIDER_EXECUTION_TARGET=auto        # "auto", "local", or "daytona"
# AIDER_MODEL=gpt-4.1                # Model for aider to use
# AIDER_TIMEOUT_MS=300000            # 5 minutes (default)
# AIDER_MAX_RETRIES=2                # Retry on edit format failures
# AIDER_FALLBACK_NATIVE=true         # Fall back to native worker on failure
# AIDER_FALLBACK_LOCAL=true          # Fall back to local if Daytona fails

# ── Sandbox Runtime (optional) ────────────────────────────────────────
# "auto" tries Daytona then falls back to local; "local" skips Daytona.
SANDBOX_RUNTIME_MODE=local
# SERVER_PUBLIC_BASE_URL=http://localhost:3001

# ── Daytona Sandbox (optional) ────────────────────────────────────────
# DAYTONA_API_URL=https://your-daytona-instance/api
# DAYTONA_API_KEY=your-daytona-api-key

# ── Billing / RevenueCat (optional) ───────────────────────────────────
# REVENUECAT_SECRET_API_KEY=your-revenuecat-key
# REVENUECAT_WEBHOOK_AUTH=your-webhook-auth-token
