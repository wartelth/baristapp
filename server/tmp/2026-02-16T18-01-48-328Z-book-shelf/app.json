{
  "appId": "book-shelf",
  "title": "BookShelf",
  "icon": "📚",
  "version": 2,
  "capabilities": [
    "localStorage",
    "network",
    "haptics",
    "clipboard"
  ],
  "screens": [
    {
      "id": "main",
      "title": "BookShelf",
      "components": [
        {
          "type": "tabs",
          "id": "main-tabs",
          "props": {
            "stateKey": "activeTab",
            "tabs": [
              {
                "label": "📖 Library",
                "value": "library",
                "children": [
                  {
                    "type": "container",
                    "id": "library-header",
                    "props": {
                      "children": [
                        {
                          "type": "text",
                          "id": "library-title",
                          "props": {
                            "content": "My Library",
                            "variant": "title"
                          }
                        },
                        {
                          "type": "button",
                          "id": "add-book-btn",
                          "props": {
                            "label": "＋ Add Book",
                            "action": {
                              "type": "batch",
                              "actions": [
                                {
                                  "type": "setState",
                                  "key": "activeTab",
                                  "value": "search"
                                },
                                {
                                  "type": "haptic",
                                  "style": "light"
                                }
                              ]
                            },
                            "variant": "primary"
                          }
                        }
                      ],
                      "direction": "row",
                      "padding": 4,
                      "align": "center",
                      "justify": "space-between"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "lib-spacer-1",
                    "props": {
                      "height": 8
                    }
                  },
                  {
                    "type": "container",
                    "id": "filter-row",
                    "props": {
                      "children": [
                        {
                          "type": "select",
                          "id": "rating-filter",
                          "props": {
                            "stateKey": "filterRating",
                            "options": [
                              {
                                "label": "All Ratings",
                                "value": "all"
                              },
                              {
                                "label": "★★★★★ Only",
                                "value": "5"
                              },
                              {
                                "label": "★★★★ & Up",
                                "value": "4"
                              },
                              {
                                "label": "★★★ & Up",
                                "value": "3"
                              }
                            ],
                            "placeholder": "Filter by rating"
                          }
                        },
                        {
                          "type": "select",
                          "id": "sort-select",
                          "props": {
                            "stateKey": "sortBy",
                            "options": [
                              {
                                "label": "Most Recent",
                                "value": "recent"
                              },
                              {
                                "label": "Highest Rated",
                                "value": "rating"
                              },
                              {
                                "label": "By Title",
                                "value": "title"
                              }
                            ],
                            "placeholder": "Sort"
                          }
                        }
                      ],
                      "direction": "row",
                      "gap": 10,
                      "align": "center"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "lib-spacer-2",
                    "props": {
                      "height": 8
                    }
                  },
                  {
                    "type": "list",
                    "id": "books-list",
                    "props": {
                      "dataKey": "books",
                      "emptyText": "No books yet! Tap '＋ Add Book' to search and log your first read.",
                      "renderItem": {
                        "components": [
                          {
                            "type": "card",
                            "id": "book-card",
                            "props": {
                              "children": [
                                {
                                  "type": "container",
                                  "id": "book-card-row",
                                  "props": {
                                    "children": [
                                      {
                                        "type": "image",
                                        "id": "book-cover-thumb",
                                        "props": {
                                          "stateKey": "coverUrl",
                                          "width": 60,
                                          "height": 90,
                                          "resizeMode": "cover"
                                        }
                                      },
                                      {
                                        "type": "container",
                                        "id": "book-info-col",
                                        "props": {
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "book-title",
                                              "props": {
                                                "content": "",
                                                "variant": "subtitle",
                                                "stateKey": "title"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "book-author",
                                              "props": {
                                                "content": "",
                                                "variant": "caption",
                                                "stateKey": "author"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "book-rating-stars",
                                              "props": {
                                                "content": "",
                                                "variant": "body",
                                                "stateKey": "ratingStars"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "book-review-preview",
                                              "props": {
                                                "content": "",
                                                "variant": "caption",
                                                "stateKey": "reviewPreview"
                                              }
                                            }
                                          ],
                                          "direction": "column",
                                          "gap": 4
                                        }
                                      }
                                    ],
                                    "direction": "row",
                                    "gap": 12,
                                    "align": "flex-start"
                                  }
                                }
                              ],
                              "elevation": 2,
                              "onPress": {
                                "type": "batch",
                                "actions": [
                                  {
                                    "type": "setState",
                                    "key": "detailBook",
                                    "value": null
                                  },
                                  {
                                    "type": "setState",
                                    "key": "showDetailModal",
                                    "value": true
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "label": "🔍 Search",
                "value": "search",
                "children": [
                  {
                    "type": "text",
                    "id": "search-title",
                    "props": {
                      "content": "Search Books",
                      "variant": "title"
                    }
                  },
                  {
                    "type": "text",
                    "id": "search-subtitle",
                    "props": {
                      "content": "Find books via Open Library and add them to your shelf",
                      "variant": "caption"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "search-spacer-1",
                    "props": {
                      "height": 12
                    }
                  },
                  {
                    "type": "container",
                    "id": "search-bar-row",
                    "props": {
                      "children": [
                        {
                          "type": "input",
                          "id": "search-input",
                          "props": {
                            "placeholder": "Search by title or author...",
                            "stateKey": "searchQuery"
                          }
                        },
                        {
                          "type": "button",
                          "id": "search-btn",
                          "props": {
                            "label": "Search",
                            "action": {
                              "type": "batch",
                              "actions": [
                                {
                                  "type": "setState",
                                  "key": "searching",
                                  "value": true
                                },
                                {
                                  "type": "setState",
                                  "key": "searchError",
                                  "value": null
                                },
                                {
                                  "type": "http",
                                  "url": "https://openlibrary.org/search.json?q={{searchQuery}}&limit=10&fields=title,author_name,first_publish_year,cover_i,subject,key",
                                  "method": "GET",
                                  "resultKey": "searchResultsRaw",
                                  "loadingKey": "searching",
                                  "errorKey": "searchError"
                                }
                              ]
                            },
                            "variant": "primary"
                          }
                        }
                      ],
                      "direction": "row",
                      "gap": 8,
                      "align": "center"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "search-spacer-2",
                    "props": {
                      "height": 8
                    }
                  },
                  {
                    "type": "text",
                    "id": "searching-indicator",
                    "props": {
                      "content": "🔍 Searching Open Library...",
                      "variant": "caption",
                      "align": "center"
                    },
                    "visibleWhen": {
                      "stateKey": "searching",
                      "operator": "truthy"
                    }
                  },
                  {
                    "type": "text",
                    "id": "search-error-msg",
                    "props": {
                      "content": "Search failed. Please check your connection and try again.",
                      "variant": "caption",
                      "align": "center"
                    },
                    "visibleWhen": {
                      "stateKey": "searchError",
                      "operator": "truthy"
                    }
                  },
                  {
                    "type": "list",
                    "id": "search-results-list",
                    "props": {
                      "dataKey": "searchResults",
                      "emptyText": "Search for a book to get started",
                      "renderItem": {
                        "components": [
                          {
                            "type": "card",
                            "id": "search-result-card",
                            "props": {
                              "children": [
                                {
                                  "type": "container",
                                  "id": "result-row",
                                  "props": {
                                    "children": [
                                      {
                                        "type": "image",
                                        "id": "result-cover",
                                        "props": {
                                          "stateKey": "coverUrl",
                                          "width": 50,
                                          "height": 75,
                                          "resizeMode": "cover"
                                        }
                                      },
                                      {
                                        "type": "container",
                                        "id": "result-info",
                                        "props": {
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "result-title",
                                              "props": {
                                                "content": "",
                                                "variant": "subtitle",
                                                "stateKey": "title"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "result-author",
                                              "props": {
                                                "content": "",
                                                "variant": "caption",
                                                "stateKey": "author"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "result-year",
                                              "props": {
                                                "content": "",
                                                "variant": "caption",
                                                "stateKey": "year"
                                              }
                                            }
                                          ],
                                          "direction": "column",
                                          "gap": 2
                                        }
                                      }
                                    ],
                                    "direction": "row",
                                    "gap": 12,
                                    "align": "center"
                                  }
                                }
                              ],
                              "elevation": 1,
                              "onPress": {
                                "type": "batch",
                                "actions": [
                                  {
                                    "type": "setState",
                                    "key": "showAddModal",
                                    "value": true
                                  },
                                  {
                                    "type": "setState",
                                    "key": "newRating",
                                    "value": 3
                                  },
                                  {
                                    "type": "setState",
                                    "key": "newReview",
                                    "value": ""
                                  },
                                  {
                                    "type": "haptic",
                                    "style": "light"
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "label": "✨ For You",
                "value": "recommend",
                "children": [
                  {
                    "type": "text",
                    "id": "rec-title",
                    "props": {
                      "content": "AI Recommendations",
                      "variant": "title"
                    }
                  },
                  {
                    "type": "text",
                    "id": "rec-subtitle",
                    "props": {
                      "content": "Personalized picks based on your reading history, ratings & reviews",
                      "variant": "caption"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "rec-spacer-1",
                    "props": {
                      "height": 12
                    }
                  },
                  {
                    "type": "button",
                    "id": "get-recs-btn",
                    "props": {
                      "label": "🤖 Get Smart Recommendations",
                      "action": {
                        "type": "batch",
                        "actions": [
                          {
                            "type": "setState",
                            "key": "loadingRecs",
                            "value": true
                          },
                          {
                            "type": "setState",
                            "key": "recError",
                            "value": null
                          },
                          {
                            "type": "serverCall",
                            "endpointId": "get-recommendations",
                            "dataKey": "books",
                            "resultKey": "recommendations",
                            "loadingKey": "loadingRecs",
                            "errorKey": "recError"
                          }
                        ]
                      },
                      "variant": "primary"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "rec-spacer-2",
                    "props": {
                      "height": 8
                    }
                  },
                  {
                    "type": "text",
                    "id": "rec-loading-text",
                    "props": {
                      "content": "🧠 Analyzing your reading taste...",
                      "variant": "body",
                      "align": "center"
                    },
                    "visibleWhen": {
                      "stateKey": "loadingRecs",
                      "operator": "truthy"
                    }
                  },
                  {
                    "type": "progress",
                    "id": "rec-loading-bar",
                    "props": {
                      "stateKey": "recProgress",
                      "variant": "bar",
                      "max": 100,
                      "color": "#7c3aed",
                      "label": "Generating recommendations..."
                    },
                    "visibleWhen": {
                      "stateKey": "loadingRecs",
                      "operator": "truthy"
                    }
                  },
                  {
                    "type": "text",
                    "id": "rec-error-text",
                    "props": {
                      "content": "Could not generate recommendations. Make sure you have books in your library!",
                      "variant": "caption",
                      "align": "center"
                    },
                    "visibleWhen": {
                      "stateKey": "recError",
                      "operator": "truthy"
                    }
                  },
                  {
                    "type": "list",
                    "id": "recommendations-list",
                    "props": {
                      "dataKey": "recommendations",
                      "emptyText": "Tap the button above to get personalized book recommendations!",
                      "renderItem": {
                        "components": [
                          {
                            "type": "card",
                            "id": "rec-card",
                            "props": {
                              "children": [
                                {
                                  "type": "container",
                                  "id": "rec-card-content",
                                  "props": {
                                    "children": [
                                      {
                                        "type": "text",
                                        "id": "rec-book-title",
                                        "props": {
                                          "content": "",
                                          "variant": "subtitle",
                                          "stateKey": "title"
                                        }
                                      },
                                      {
                                        "type": "text",
                                        "id": "rec-book-author",
                                        "props": {
                                          "content": "",
                                          "variant": "caption",
                                          "stateKey": "author"
                                        }
                                      },
                                      {
                                        "type": "divider",
                                        "id": "rec-divider",
                                        "props": {
                                          "color": "#2a2a3e",
                                          "thickness": 1,
                                          "marginVertical": 6
                                        }
                                      },
                                      {
                                        "type": "text",
                                        "id": "rec-reason",
                                        "props": {
                                          "content": "",
                                          "variant": "body",
                                          "stateKey": "reason"
                                        }
                                      },
                                      {
                                        "type": "text",
                                        "id": "rec-match-score",
                                        "props": {
                                          "content": "",
                                          "variant": "caption",
                                          "stateKey": "matchLabel"
                                        }
                                      }
                                    ],
                                    "direction": "column",
                                    "gap": 6
                                  }
                                }
                              ],
                              "elevation": 2
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "label": "📊 Stats",
                "value": "stats",
                "children": [
                  {
                    "type": "text",
                    "id": "stats-title",
                    "props": {
                      "content": "Reading Stats",
                      "variant": "title"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "stats-spacer-1",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "container",
                    "id": "stats-cards-row",
                    "props": {
                      "children": [
                        {
                          "type": "card",
                          "id": "stat-total-card",
                          "props": {
                            "children": [
                              {
                                "type": "container",
                                "id": "stat-total-content",
                                "props": {
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "stat-total-label",
                                      "props": {
                                        "content": "📚 Books Read",
                                        "variant": "caption",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "stat-total-value",
                                      "props": {
                                        "content": "0",
                                        "variant": "title",
                                        "align": "center",
                                        "stateKey": "statsTotal"
                                      }
                                    }
                                  ],
                                  "direction": "column",
                                  "gap": 4,
                                  "padding": 8,
                                  "align": "center"
                                }
                              }
                            ],
                            "elevation": 2
                          }
                        },
                        {
                          "type": "card",
                          "id": "stat-avg-card",
                          "props": {
                            "children": [
                              {
                                "type": "container",
                                "id": "stat-avg-content",
                                "props": {
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "stat-avg-label",
                                      "props": {
                                        "content": "⭐ Avg Rating",
                                        "variant": "caption",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "stat-avg-value",
                                      "props": {
                                        "content": "0",
                                        "variant": "title",
                                        "align": "center",
                                        "stateKey": "statsAvgRating"
                                      }
                                    }
                                  ],
                                  "direction": "column",
                                  "gap": 4,
                                  "padding": 8,
                                  "align": "center"
                                }
                              }
                            ],
                            "elevation": 2
                          }
                        }
                      ],
                      "direction": "row",
                      "gap": 12,
                      "justify": "space-around",
                      "wrap": true
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "stats-spacer-2",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "text",
                    "id": "rating-dist-title",
                    "props": {
                      "content": "Rating Distribution",
                      "variant": "subtitle"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "stats-spacer-3",
                    "props": {
                      "height": 8
                    }
                  },
                  {
                    "type": "chart",
                    "id": "rating-chart",
                    "props": {
                      "chartType": "bar",
                      "dataKey": "ratingDistribution",
                      "xKey": "label",
                      "yKey": "value",
                      "height": 200,
                      "color": "#7c3aed"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "stats-spacer-4",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "text",
                    "id": "reading-timeline-title",
                    "props": {
                      "content": "Books Over Time",
                      "variant": "subtitle"
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "stats-spacer-5",
                    "props": {
                      "height": 8
                    }
                  },
                  {
                    "type": "chart",
                    "id": "timeline-chart",
                    "props": {
                      "chartType": "line",
                      "dataKey": "readingTimeline",
                      "xKey": "label",
                      "yKey": "value",
                      "height": 180,
                      "color": "#22c55e"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "modal",
          "id": "add-book-modal",
          "props": {
            "visibleKey": "showAddModal",
            "title": "Log This Book",
            "children": [
              {
                "type": "text",
                "id": "modal-selected-title",
                "props": {
                  "content": "Rate and review this book",
                  "variant": "subtitle",
                  "align": "center"
                }
              },
              {
                "type": "spacer",
                "id": "modal-spacer-1",
                "props": {
                  "height": 16
                }
              },
              {
                "type": "text",
                "id": "rating-label",
                "props": {
                  "content": "Your Rating",
                  "variant": "body"
                }
              },
              {
                "type": "slider",
                "id": "rating-slider",
                "props": {
                  "stateKey": "newRating",
                  "min": 1,
                  "max": 5,
                  "step": 1,
                  "label": "★ Rating"
                }
              },
              {
                "type": "spacer",
                "id": "modal-spacer-2",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "text",
                "id": "review-label",
                "props": {
                  "content": "Your Notes / Review (optional)",
                  "variant": "body"
                }
              },
              {
                "type": "input",
                "id": "review-input",
                "props": {
                  "placeholder": "What did you think? Key takeaways, favorite quotes...",
                  "stateKey": "newReview",
                  "multiline": true
                }
              },
              {
                "type": "spacer",
                "id": "modal-spacer-3",
                "props": {
                  "height": 16
                }
              },
              {
                "type": "container",
                "id": "modal-btn-row",
                "props": {
                  "children": [
                    {
                      "type": "button",
                      "id": "cancel-add-btn",
                      "props": {
                        "label": "Cancel",
                        "action": {
                          "type": "setState",
                          "key": "showAddModal",
                          "value": false
                        },
                        "variant": "secondary"
                      }
                    },
                    {
                      "type": "button",
                      "id": "confirm-add-btn",
                      "props": {
                        "label": "📖 Add to Library",
                        "action": {
                          "type": "batch",
                          "actions": [
                            {
                              "type": "append",
                              "key": "books",
                              "fromKey": "selectedBook"
                            },
                            {
                              "type": "setState",
                              "key": "showAddModal",
                              "value": false
                            },
                            {
                              "type": "setState",
                              "key": "selectedBook",
                              "value": null
                            },
                            {
                              "type": "haptic",
                              "style": "success"
                            },
                            {
                              "type": "compute",
                              "operation": "length",
                              "key": "books",
                              "resultKey": "statsTotal"
                            }
                          ]
                        },
                        "variant": "primary"
                      }
                    }
                  ],
                  "direction": "row",
                  "gap": 12,
                  "justify": "center"
                }
              }
            ]
          }
        },
        {
          "type": "modal",
          "id": "detail-modal",
          "props": {
            "visibleKey": "showDetailModal",
            "title": "Book Details",
            "children": [
              {
                "type": "text",
                "id": "detail-title",
                "props": {
                  "content": "",
                  "variant": "title",
                  "align": "center",
                  "stateKey": "detailTitle"
                }
              },
              {
                "type": "text",
                "id": "detail-author",
                "props": {
                  "content": "",
                  "variant": "caption",
                  "align": "center",
                  "stateKey": "detailAuthor"
                }
              },
              {
                "type": "spacer",
                "id": "detail-spacer-1",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "image",
                "id": "detail-cover",
                "props": {
                  "stateKey": "detailCover",
                  "height": 200,
                  "resizeMode": "contain"
                }
              },
              {
                "type": "spacer",
                "id": "detail-spacer-2",
                "props": {
                  "height": 12
                }
              },
              {
                "type": "text",
                "id": "detail-rating",
                "props": {
                  "content": "",
                  "variant": "subtitle",
                  "align": "center",
                  "stateKey": "detailRating"
                }
              },
              {
                "type": "divider",
                "id": "detail-divider",
                "props": {
                  "color": "#2a2a3e",
                  "thickness": 1,
                  "marginVertical": 12
                }
              },
              {
                "type": "text",
                "id": "detail-review-label",
                "props": {
                  "content": "Your Review",
                  "variant": "subtitle"
                }
              },
              {
                "type": "text",
                "id": "detail-review",
                "props": {
                  "content": "No review written",
                  "variant": "body",
                  "stateKey": "detailReview"
                }
              },
              {
                "type": "spacer",
                "id": "detail-spacer-3",
                "props": {
                  "height": 12
                }
              },
              {
                "type": "text",
                "id": "detail-date",
                "props": {
                  "content": "",
                  "variant": "caption",
                  "align": "center",
                  "stateKey": "detailDate"
                }
              },
              {
                "type": "spacer",
                "id": "detail-spacer-4",
                "props": {
                  "height": 16
                }
              },
              {
                "type": "container",
                "id": "detail-action-row",
                "props": {
                  "children": [
                    {
                      "type": "button",
                      "id": "detail-close-btn",
                      "props": {
                        "label": "Close",
                        "action": {
                          "type": "setState",
                          "key": "showDetailModal",
                          "value": false
                        },
                        "variant": "secondary"
                      }
                    },
                    {
                      "type": "button",
                      "id": "copy-review-btn",
                      "props": {
                        "label": "📋 Copy Review",
                        "action": {
                          "type": "batch",
                          "actions": [
                            {
                              "type": "copyToClipboard",
                              "fromKey": "detailReview"
                            },
                            {
                              "type": "haptic",
                              "style": "success"
                            }
                          ]
                        },
                        "variant": "secondary"
                      }
                    },
                    {
                      "type": "button",
                      "id": "delete-book-btn",
                      "props": {
                        "label": "🗑️ Remove",
                        "action": {
                          "type": "batch",
                          "actions": [
                            {
                              "type": "remove",
                              "key": "books",
                              "index": 0
                            },
                            {
                              "type": "setState",
                              "key": "showDetailModal",
                              "value": false
                            },
                            {
                              "type": "haptic",
                              "style": "warning"
                            },
                            {
                              "type": "compute",
                              "operation": "length",
                              "key": "books",
                              "resultKey": "statsTotal"
                            }
                          ]
                        },
                        "variant": "danger"
                      }
                    }
                  ],
                  "direction": "row",
                  "gap": 12,
                  "justify": "center"
                }
              }
            ]
          }
        }
      ]
    }
  ],
