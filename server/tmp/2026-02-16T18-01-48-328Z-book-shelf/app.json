              },
              {
                "label": "★★",
                "value": 0
              },
              {
                "label": "★★★",
                "value": 0
              },
              {
                "label": "★★★★",
                "value": 0
              },
              {
                "label": "★★★★★",
                "value": 0
              }
            ]
          },
          {
            "type": "setState",
            "key": "readingTimeline",
            "value": []
          }
        ]
      }
    }
  ]
