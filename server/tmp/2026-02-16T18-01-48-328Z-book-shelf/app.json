  "theme": {
    "backgroundColor": "#111118",
    "surfaceColor": "#1a1a2e",
    "primaryColor": "#7c3aed",
    "textColor": "#f0f0f0",
    "secondaryTextColor": "#8888aa",
    "borderColor": "#2a2a3e",
    "dangerColor": "#dc2626",
    "successColor": "#22c55e"
  },
  "serverEndpoints": [
    {
      "id": "search-books",
      "method": "GET",
      "processing": {
        "type": "proxy",
        "targetUrl": "https://openlibrary.org/search.json?q={{searchQuery}}&limit=8&fields=title,author_name,first_publish_year,cover_i,subject,key"
      }
    },
    {
      "id": "get-recommendations",
      "method": "POST",
      "processing": {
        "type": "huggingface",
        "model": "claude-sonnet-4-5-20250929",
        "task": "text-generation"
      }
    }
  ],
  "effects": [
    {
      "trigger": "onMount",
      "action": {
        "type": "batch",
        "actions": [
          {
            "type": "compute",
            "operation": "length",
            "key": "books",
            "resultKey": "statsTotal"
          },
          {
            "type": "setState",
            "key": "ratingDistribution",
            "value": [
              {
                "label": "★",
