{
  "appId": "workout-rep-counter",
  "title": "Workout Rep Counter",
  "icon": "💪",
  "version": 1,
  "capabilities": [
    "localStorage"
  ],
  "screens": [
    {
      "id": "main",
      "title": "Workout Tracker",
      "components": [
        {
          "type": "text",
          "id": "header-text",
          "props": {
            "content": "Track Your Reps",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "pushups-label",
          "props": {
            "content": "Push-ups",
            "variant": "subtitle"
          }
        },
        {
          "type": "text",
          "id": "pushups-count",
          "props": {
            "content": "0",
            "variant": "title",
            "align": "center",
            "stateKey": "pushups"
          }
        },
        {
          "type": "button",
          "id": "pushups-increment",
          "props": {
            "label": "+ Add Rep",
            "action": {
              "type": "setState",
              "key": "pushups",
              "value": 1
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "pushups-reset",
          "props": {
            "label": "Reset",
            "action": {
              "type": "setState",
              "key": "pushups",
              "value": 0
            },
            "variant": "secondary"
          }
        },
        {
          "type": "text",
          "id": "squats-label",
          "props": {
            "content": "Squats",
            "variant": "subtitle"
          }
        },
        {
          "type": "text",
          "id": "squats-count",
          "props": {
            "content": "0",
            "variant": "title",
            "align": "center",
            "stateKey": "squats"
          }
        },
        {
          "type": "button",
          "id": "squats-increment",
          "props": {
            "label": "+ Add Rep",
            "action": {
              "type": "setState",
              "key": "squats",
              "value": 1
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "squats-reset",
          "props": {
            "label": "Reset",
            "action": {
              "type": "setState",
              "key": "squats",
              "value": 0
            },
            "variant": "secondary"
          }
        },
        {
          "type": "text",
          "id": "planks-label",
          "props": {
            "content": "Planks (seconds)",
            "variant": "subtitle"
          }
        },
        {
          "type": "text",
          "id": "planks-count",
          "props": {
            "content": "0",
            "variant": "title",
            "align": "center",
            "stateKey": "planks"
          }
        },
        {
          "type": "button",
          "id": "planks-increment-10",
          "props": {
            "label": "+ 10 Seconds",
            "action": {
              "type": "setState",
              "key": "planks",
              "value": 10
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "planks-increment-30",
          "props": {
            "label": "+ 30 Seconds",
            "action": {
              "type": "setState",
              "key": "planks",
              "value": 30
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "planks-reset",
          "props": {
            "label": "Reset",
            "action": {
              "type": "setState",
              "key": "planks",
              "value": 0
            },
            "variant": "secondary"
          }
        },
        {
          "type": "button",
          "id": "reset-all",
          "props": {
            "label": "Reset All Counters",
            "action": {
              "type": "setState",
              "key": "pushups",
              "value": 0
            },
            "variant": "danger"
          }
        }
      ]
    }
  ],
  "initialState": {
    "pushups": 0,
    "squats": 0,
    "planks": 0
  }
}