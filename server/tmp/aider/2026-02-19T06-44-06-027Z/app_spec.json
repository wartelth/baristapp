{
  "appId": "cpp-duolingo-gnc",
  "title": "C++ Quest pour Ingénieurs GNC",
  "icon": "🎯",
  "version": 1.0,
  "capabilities": [
    "localStorage",
    "haptics",
    "notifications"
  ],
  "screens": [
    {
      "id": "home",
      "title": "Accueil",
      "components": [
        {
          "type": "container",
          "id": "home-layout",
          "props": {
            "direction": "column",
            "gap": 16,
            "padding": 16,
            "children": [
              {
                "type": "text",
                "id": "home-title",
                "props": {
                  "content": "C++ Quest pour Ingénieurs GNC",
                  "variant": "title",
                  "align": "center"
                }
              },
              {
                "type": "text",
                "id": "home-subtitle",
                "props": {
                  "content": "Entraînement C++ ciblé pour systèmes embarqués et GNC",
                  "variant": "subtitle",
                  "align": "center"
                }
              },
              {
                "type": "card",
                "id": "home-stats-card",
                "props": {
                  "title": "Votre progression",
                  "subtitle": "Gardez votre streak et gagnez des XP",
                  "elevation": 2,
                  "children": [
                    {
                      "type": "container",
                      "id": "home-stats-row",
                      "props": {
                        "direction": "row",
                        "gap": 12,
                        "children": [
                          {
                            "type": "card",
                            "id": "home-streak-card",
                            "props": {
                              "title": "Streak",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "home-streak-text",
                                  "props": {
                                    "content": "🔥",
                                    "variant": "title",
                                    "align": "center"
                                  }
                                },
                                {
                                  "type": "text",
                                  "id": "home-streak-days",
                                  "props": {
                                    "content": "0 jours",
                                    "variant": "body",
                                    "align": "center",
                                    "stateKey": "currentStreakLabel"
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "type": "card",
                            "id": "home-xp-card",
                            "props": {
                              "title": "XP",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "home-xp-value",
                                  "props": {
                                    "content": "0 XP",
                                    "variant": "title",
                                    "align": "center",
                                    "stateKey": "xpLabel"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "button",
                "id": "home-start-lesson",
                "props": {
                  "label": "Commencer une leçon",
                  "variant": "primary",
                  "action": {
                    "type": "navigate",
                    "screenId": "lesson"
                  }
                }
              },
              {
                "type": "button",
                "id": "home-view-achievements",
                "props": {
                  "label": "Voir les badges",
                  "variant": "secondary",
                  "action": {
                    "type": "navigate",
                    "screenId": "achievements"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "lesson",
      "title": "Leçon C++",
      "components": [
        {
          "type": "container",
          "id": "lesson-layout",
          "props": {
            "direction": "column",
            "gap": 16,
            "padding": 16,
            "children": [
              {
                "type": "text",
                "id": "lesson-header",
                "props": {
                  "content": "Question C++ pour GNC",
                  "variant": "title"
                }
              },
              {
                "type": "card",
                "id": "lesson-question-card",
                "props": {
                  "children": [
                    {
                      "type": "text",
                      "id": "lesson-question",
                      "props": {
                        "content": "Quelle est la meilleure structure pour représenter un vecteur d'état (position, vitesse) en C++ moderne ?",
                        "variant": "body",
                        "stateKey": "currentQuestionText"
                      }
                    }
                  ]
                }
              },
              {
                "type": "card",
                "id": "lesson-options-card",
                "props": {
                  "children": [
                    {
                      "type": "list",
                      "id": "lesson-options-list",
                      "props": {
                        "dataKey": "currentQuestionOptions",
                        "emptyText": "Aucune option disponible",
                        "renderItem": {
                          "components": [
                            {
                              "type": "button",
                              "id": "lesson-option-button",
                              "props": {
                                "label": "Option",
                                "action": {
                                  "type": "batch",
                                  "actions": [
                                    {
                                      "type": "setState",
                                      "key": "selectedOption",
                                      "value": "index"
                                    },
                                    {
                                      "type": "setState",
                                      "key": "showAnswerResult",
                                      "value": true
                                    }
                                  ]
                                },
                                "variant": "secondary"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "modal",
                "id": "lesson-result-modal",
                "props": {
                  "visibleKey": "showAnswerResult",
                  "title": "Résultat",
                  "children": [
                    {
                      "type": "text",
                      "id": "lesson-result-text",
                      "props": {
                        "content": "Bonne réponse !",
                        "variant": "title",
                        "align": "center",
                        "stateKey": "answerResultText"
                      }
                    },
                    {
                      "type": "text",
                      "id": "lesson-explanation-text",
                      "props": {
                        "content": "Explication détaillée sur l'usage des structures C++ dans les systèmes GNC.",
                        "variant": "body",
                        "stateKey": "answerExplanationText"
                      }
                    },
                    {
                      "type": "button",
                      "id": "lesson-next-button",
                      "props": {
                        "label": "Question suivante",
                        "variant": "primary",
                        "action": {
                          "type": "batch",
                          "actions": [
                            {
                              "type": "setState",
                              "key": "showAnswerResult",
                              "value": false
                            },
                            {
                              "type": "compute",
                              "operation": "increment",
                              "key": "xp"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "type": "button",
                "id": "lesson-back-home",
                "props": {
                  "label": "Retour à l'accueil",
                  "variant": "secondary",
                  "action": {
                    "type": "navigate",
                    "screenId": "home"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "achievements",
      "title": "Badges",
      "components": [
        {
          "type": "container",
          "id": "achievements-layout",
          "props": {
            "direction": "column",
            "gap": 16,
            "padding": 16,
            "children": [
              {
                "type": "text",
                "id": "achievements-title",
                "props": {
                  "content": "Vos badges C++",
                  "variant": "title"
                }
              },
              {
                "type": "list",
                "id": "achievements-list",
                "props": {
                  "dataKey": "achievements",
                  "emptyText": "Aucun badge débloqué pour l'instant.",
                  "renderItem": {
                    "components": [
                      {
                        "type": "card",
                        "id": "achievement-card",
                        "props": {
                          "children": [
                            {
                              "type": "text",
                              "id": "achievement-name",
                              "props": {
                                "content": "Badge",
                                "variant": "subtitle",
                                "stateKey": "item.name"
                              }
                            },
                            {
                              "type": "text",
                              "id": "achievement-desc",
                              "props": {
                                "content": "Description",
                                "variant": "body",
                                "stateKey": "item.description"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              {
                "type": "button",
                "id": "achievements-back-home",
                "props": {
                  "label": "Retour à l'accueil",
                  "variant": "secondary",
                  "action": {
                    "type": "navigate",
                    "screenId": "home"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "initialState": {
    "currentStreak": 0,
    "currentStreakLabel": "0 jours",
    "xp": 0,
    "xpLabel": "0 XP",
    "currentQuestionText": "Quelle est la meilleure structure pour représenter un vecteur d'état (position, vitesse) en C++ moderne ?",
    "currentQuestionOptions": [
      {
        "label": "std::array<double, 6>",
        "value": "array6"
      },
      {
        "label": "std::vector<double>",
        "value": "vector"
      },
      {
        "label": "double state[6]",
        "value": "carray"
      },
      {
        "label": "std::tuple<double, double, double, double, double, double>",
        "value": "tuple"
      }
    ],
    "selectedOption": null,
    "showAnswerResult": false,
    "answerResultText": "",
    "answerExplanationText": "",
    "achievements": [
      {
        "name": "Premiers pas GNC",
        "description": "A terminé la première leçon C++ orientée GNC."
      },
      {
        "name": "Spécialiste pointeurs sûrs",
        "description": "A répondu correctement à 10 questions sur la gestion mémoire moderne."
      }
    ]
  },
  "theme": {
    "backgroundColor": "#050816",
    "surfaceColor": "#111827",
    "primaryColor": "#22c55e",
    "textColor": "#f9fafb",
    "secondaryTextColor": "#9ca3af",
    "borderColor": "#1f2933",
    "dangerColor": "#ef4444",
    "successColor": "#22c55e"
  },
  "serverEndpoints": [],
  "effects": [],
  "dataModel": {}
}
