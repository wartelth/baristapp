{
  "appId": "fr-news-tech-bookmarks",
  "title": "Actu Tech France",
  "icon": "📰",
  "version": 2,
  "capabilities": [
    "skills",
    "localStorage"
  ],
  "skills": [
    "news-headlines"
  ],
  "screens": [
    {
      "id": "home",
      "title": "Actu Tech France",
      "components": [
        {
          "type": "text",
          "id": "header-title",
          "props": {
            "content": "Titres tech en France",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "button",
          "id": "refresh-headlines",
          "props": {
            "label": "Actualiser les titres",
            "variant": "primary",
            "action": {
              "type": "skillCall",
              "skillId": "news-headlines",
              "actionId": "top",
              "params": {
                "country": "fr",
                "category": "technology",
                "pageSize": 20
              },
              "resultKey": "articles",
              "loadingKey": "loading",
              "errorKey": "error"
            }
          }
        },
        {
          "type": "text",
          "id": "loading-text",
          "props": {
            "content": "Chargement des dernières actus tech...",
            "variant": "body",
            "align": "center",
            "stateKey": "loading"
          },
          "visibleWhen": {
            "stateKey": "loading",
            "operator": "truthy"
          }
        },
        {
          "type": "text",
          "id": "error-text",
          "props": {
            "content": "Impossible de récupérer les actus. Réessayez.",
            "variant": "body",
            "align": "center"
          },
          "visibleWhen": {
            "stateKey": "error",
            "operator": "truthy"
          }
        },
        {
          "type": "list",
          "id": "articles-list",
          "props": {
            "dataKey": "articles",
            "emptyText": "Aucune actu tech disponible pour le moment.",
            "renderItem": {
              "components": [
                {
                  "type": "card",
                  "id": "article-card",
                  "props": {
                    "title": "",
                    "subtitle": "",
                    "elevation": 2,
                    "children": [
                      {
                        "type": "image",
                        "id": "article-image",
                        "props": {
                          "uri": "",
                          "stateKey": "item.urlToImage",
                          "height": 160,
                          "resizeMode": "cover"
                        },
                        "visibleWhen": {
                          "stateKey": "item.urlToImage",
                          "operator": "truthy"
                        }
                      },
                      {
                        "type": "text",
                        "id": "article-title",
                        "props": {
                          "content": "",
                          "variant": "subtitle",
                          "stateKey": "item.title"
                        }
                      },
                      {
                        "type": "text",
                        "id": "article-description",
                        "props": {
                          "content": "",
                          "variant": "body",
                          "stateKey": "item.description"
                        },
                        "visibleWhen": {
                          "stateKey": "item.description",
                          "operator": "truthy"
                        }
                      },
                      {
                        "type": "button",
                        "id": "bookmark-article",
                        "props": {
                          "label": "Bookmark",
                          "variant": "secondary",
                          "action": {
                            "type": "append",
                            "key": "bookmarks",
                            "fromKey": "articles",
                            "value": {
                              "stateKey": "item"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          "visibleWhen": {
            "stateKey": "loading",
            "operator": "falsy"
          }
        }
      ]
    }
  ],
  "initialState": {
    "articles": [],
    "loading": false,
    "error": null,
    "bookmarks": []
  },
  "theme": {
    "backgroundColor": "#111118",
    "surfaceColor": "#1e1e2e",
    "primaryColor": "#4f46e5",
    "textColor": "#ffffff",
    "secondaryTextColor": "#a1a1aa",
    "borderColor": "#27272f",
    "dangerColor": "#f97373",
    "successColor": "#22c55e"
  },
  "serverEndpoints": [],
  "effects": [
    {
      "trigger": "onMount",
      "action": {
        "type": "skillCall",
        "skillId": "news-headlines",
        "actionId": "top",
        "params": {
          "country": "fr",
          "category": "technology",
          "pageSize": 20
        },
        "resultKey": "articles",
        "loadingKey": "loading",
        "errorKey": "error"
      }
    }
  ],
  "dataModel": {}
}
