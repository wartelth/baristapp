{
  "appId": "dino-lingo",
  "title": "DinoLingo: Parler Dinosaure",
  "icon": "🦖",
  "version": 2,
  "capabilities": [
    "localStorage",
    "microphone",
    "haptics"
  ],
  "screens": [
    {
      "id": "home",
      "title": "Accueil",
      "components": [
        {
          "type": "text",
          "id": "title_home",
          "props": {
            "content": "Apprends à parler Dinosaure",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "subtitle_home",
          "props": {
            "content": "Une appli façon Duolingo, mais pour les dinosaures (et les humains qui les aiment).",
            "variant": "body",
            "align": "center"
          }
        },
        {
          "type": "spacer",
          "id": "spacer_home_1",
          "props": {
            "height": 16
          }
        },
        {
          "type": "button",
          "id": "btn_start_pronunciation",
          "props": {
            "label": "S'entraîner à la prononciation",
            "variant": "primary",
            "action": {
              "type": "navigate",
              "screenId": "pronunciation"
            }
          }
        },
        {
          "type": "button",
          "id": "btn_start_quiz",
          "props": {
            "label": "Mini‑jeux & quiz",
            "variant": "secondary",
            "action": {
              "type": "navigate",
              "screenId": "quiz"
            }
          }
        },
        {
          "type": "spacer",
          "id": "spacer_home_2",
          "props": {
            "height": 24
          }
        },
        {
          "type": "progress",
          "id": "overall_progress",
          "props": {
            "stateKey": "overallProgress",
            "variant": "bar",
            "max": 100,
            "label": "Progression générale",
            "height": 8
          }
        }
      ]
    },
    {
      "id": "pronunciation",
      "title": "Prononciation Dino",
      "components": [
        {
          "type": "text",
          "id": "title_pronunciation",
          "props": {
            "content": "Prononce comme un T‑Rex",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "hint_pronunciation",
          "props": {
            "content": "Appuie sur le micro, imite le cri ou la phrase en Dino, puis vérifie ton score.",
            "variant": "body",
            "align": "center"
          }
        },
        {
          "type": "spacer",
          "id": "spacer_pronunciation_1",
          "props": {
            "height": 12
          }
        },
        {
          "type": "card",
          "id": "card_current_phrase",
          "props": {
            "title": "Phrase du jour",
            "subtitle": "Essaie de la prononcer en Dino",
            "children": [
              {
                "type": "text",
                "id": "current_phrase_text",
                "props": {
                  "content": "Grrrahk tchi-raa ! (\"Salut, troupeau !\")",
                  "variant": "subtitle",
                  "align": "center"
                }
              }
            ],
            "elevation": 2
          }
        },
        {
          "type": "spacer",
          "id": "spacer_pronunciation_2",
          "props": {
            "height": 16
          }
        },
        {
          "type": "audioRecorder",
          "id": "recorder_dino",
          "props": {
            "stateKey": "lastRecording",
            "maxDuration": 10,
            "onRecordComplete": {
              "type": "batch",
              "actions": [
                {
                  "type": "setState",
                  "key": "lastPronunciationScore",
                  "value": 78
                },
                {
                  "type": "haptic",
                  "style": "success"
                }
              ]
            }
          }
        },
        {
          "type": "spacer",
          "id": "spacer_pronunciation_3",
          "props": {
            "height": 12
          }
        },
        {
          "type": "progress",
          "id": "pronunciation_score",
          "props": {
            "stateKey": "lastPronunciationScore",
            "variant": "circle",
            "max": 100,
            "label": "Score de prononciation",
            "size": 80
          }
        },
        {
          "type": "spacer",
          "id": "spacer_pronunciation_4",
          "props": {
            "height": 16
          }
        },
        {
          "type": "button",
          "id": "btn_next_phrase",
          "props": {
            "label": "Nouvelle phrase Dino",
            "variant": "secondary",
            "action": {
              "type": "compute",
              "operation": "random",
              "key": "dummy",
              "resultKey": "phraseIndex"
            }
          }
        }
      ]
    },
    {
      "id": "quiz",
      "title": "Quiz Dino",
      "components": [
        {
          "type": "text",
          "id": "title_quiz",
          "props": {
            "content": "Mini‑jeux & quiz",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "subtitle_quiz",
          "props": {
            "content": "Choisis la bonne traduction Dino pour gagner des fossiles.",
            "variant": "body",
            "align": "center"
          }
        },
        {
          "type": "spacer",
          "id": "spacer_quiz_1",
          "props": {
            "height": 16
          }
        },
        {
          "type": "card",
          "id": "card_quiz_question",
          "props": {
            "title": "Question 1",
            "children": [
              {
                "type": "text",
                "id": "quiz_question_text",
                "props": {
                  "content": "Que veut dire \"Raaarrk\" en langage Tricératops ?",
                  "variant": "subtitle"
                }
              }
            ],
            "elevation": 1
          }
        },
        {
          "type": "spacer",
          "id": "spacer_quiz_2",
          "props": {
            "height": 12
          }
        },
        {
          "type": "container",
          "id": "quiz_answers_container",
          "props": {
            "direction": "column",
            "gap": 8,
            "children": [
              {
                "type": "button",
                "id": "answer_1",
                "props": {
                  "label": "A) Bonjour !",
                  "variant": "secondary",
                  "action": {
                    "type": "batch",
                    "actions": [
                      {
                        "type": "setState",
                        "key": "lastQuizCorrect",
                        "value": true
                      },
                      {
                        "type": "haptic",
                        "style": "success"
                      }
                    ]
                  }
                }
              },
              {
                "type": "button",
                "id": "answer_2",
                "props": {
                  "label": "B) Je suis en colère.",
                  "variant": "secondary",
                  "action": {
                    "type": "batch",
                    "actions": [
                      {
                        "type": "setState",
                        "key": "lastQuizCorrect",
                        "value": false
                      },
                      {
                        "type": "haptic",
                        "style": "warning"
                      }
                    ]
                  }
                }
              },
              {
                "type": "button",
                "id": "answer_3",
                "props": {
                  "label": "C) Où est ma meute ?",
                  "variant": "secondary",
                  "action": {
                    "type": "batch",
                    "actions": [
                      {
                        "type": "setState",
                        "key": "lastQuizCorrect",
                        "value": false
                      },
                      {
                        "type": "haptic",
                        "style": "warning"
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "type": "spacer",
          "id": "spacer_quiz_3",
          "props": {
            "height": 12
          }
        },
        {
          "type": "text",
          "id": "quiz_feedback_correct",
          "props": {
            "content": "Correct ! Tu gagnes 3 fossiles.",
            "variant": "body",
            "align": "center",
            "stateKey": "lastQuizCorrect"
          },
          "visibleWhen": {
            "stateKey": "lastQuizCorrect",
            "operator": "eq",
            "value": true
          }
        },
        {
          "type": "text",
          "id": "quiz_feedback_wrong",
          "props": {
            "content": "Pas tout à fait… essaie encore !",
            "variant": "body",
            "align": "center",
            "stateKey": "lastQuizCorrect"
          },
          "visibleWhen": {
            "stateKey": "lastQuizCorrect",
            "operator": "eq",
            "value": false
          }
        },
        {
          "type": "spacer",
          "id": "spacer_quiz_4",
          "props": {
            "height": 16
          }
        },
        {
          "type": "button",
          "id": "btn_next_quiz",
          "props": {
            "label": "Question suivante",
            "variant": "primary",
            "action": {
              "type": "compute",
              "operation": "increment",
              "key": "quizQuestionIndex",
              "resultKey": "quizQuestionIndex"
            }
          }
        }
      ]
    }
  ],
  "initialState": {
    "overallProgress": 20,
    "lastPronunciationScore": 0,
    "phraseIndex": 0,
    "lastQuizCorrect": null,
    "quizQuestionIndex": 0
  },
  "theme": {
    "backgroundColor": "#051014",
    "surfaceColor": "#10222E",
    "primaryColor": "#00C896",
    "textColor": "#FFFFFF",
    "secondaryTextColor": "#B3C5D7",
    "borderColor": "#1F3B4D",
    "dangerColor": "#FF5A5F",
    "successColor": "#00C896"
  },
  "capabilitiesNotes": "localStorage pour la progression, microphone pour la prononciation, haptics pour le feedback ludique.",
  "dataModel": {
    "userProfile": {
      "level": "beginner",
      "streakDays": 0
    },
    "lessons": [
      {
        "id": "roars_basics",
        "title": "Rugissements de base"
      }
    ]
  }
}
