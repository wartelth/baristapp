{
  "appId": "marathon-calorie-tracker",
  "title": "Marathon Fuel Tracker",
  "icon": "🍔",
  "version": 2,
  "capabilities": [
    "localStorage"
  ],
  "screens": [
    {
      "id": "main",
      "title": "Marathon Fuel Tracker",
      "components": [
        {
          "type": "tabs",
          "id": "main-tabs",
          "props": {
            "stateKey": "activeTab",
            "tabs": [
              {
                "label": "Log",
                "value": "log",
                "children": [
                  {
                    "type": "card",
                    "id": "daily-summary-card",
                    "props": {
                      "title": "Today's Intake",
                      "children": [
                        {
                          "type": "container",
                          "id": "summary-container",
                          "props": {
                            "children": [
                              {
                                "type": "container",
                                "id": "calories-col",
                                "props": {
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "calories-label",
                                      "props": {
                                        "content": "Calories",
                                        "variant": "caption",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "calories-value",
                                      "props": {
                                        "content": "0",
                                        "variant": "title",
                                        "align": "center",
                                        "stateKey": "totalCalories"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "calories-goal",
                                      "props": {
                                        "content": "/ 3500 kcal",
                                        "variant": "caption",
                                        "align": "center"
                                      }
                                    }
                                  ],
                                  "direction": "column",
                                  "align": "center"
                                }
                              },
                              {
                                "type": "container",
                                "id": "burgers-col",
                                "props": {
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "burgers-label",
                                      "props": {
                                        "content": "🍔 Burgers",
                                        "variant": "caption",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "burgers-value",
                                      "props": {
                                        "content": "0",
                                        "variant": "title",
                                        "align": "center",
                                        "stateKey": "totalBurgers"
                                      }
                                    }
                                  ],
                                  "direction": "column",
                                  "align": "center"
                                }
                              }
                            ],
                            "direction": "row",
                            "gap": 16,
                            "justify": "space-between"
                          }
                        },
                        {
                          "type": "progress",
                          "id": "calorie-progress",
                          "props": {
                            "stateKey": "totalCalories",
                            "variant": "bar",
                            "max": 3500,
                            "color": "#22c55e",
                            "height": 12
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "spacer-1",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "card",
                    "id": "quick-add-card",
                    "props": {
                      "title": "Quick Add",
                      "children": [
                        {
                          "type": "container",
                          "id": "quick-buttons",
                          "props": {
                            "children": [
                              {
                                "type": "button",
                                "id": "add-burger-btn",
                                "props": {
                                  "label": "🍔 Burger (550)",
                                  "action": {
                                    "type": "batch",
                                    "actions": [
                                      {
                                        "type": "append",
                                        "key": "meals",
                                        "value": {
                                          "name": "Burger",
                                          "calories": 550,
                                          "time": "now",
                                          "emoji": "🍔"
                                        }
                                      },
                                      {
                                        "type": "compute",
                                        "operation": "add",
                                        "key": "totalCalories",
                                        "operands": [
                                          550
                                        ],
                                        "resultKey": "totalCalories"
                                      },
                                      {
                                        "type": "compute",
                                        "operation": "increment",
                                        "key": "totalBurgers"
                                      }
                                    ]
                                  },
                                  "variant": "secondary"
                                }
                              },
                              {
                                "type": "button",
                                "id": "add-pasta-btn",
                                "props": {
                                  "label": "🍝 Pasta (400)",
                                  "action": {
                                    "type": "batch",
                                    "actions": [
                                      {
                                        "type": "append",
                                        "key": "meals",
                                        "value": {
                                          "name": "Pasta",
                                          "calories": 400,
                                          "time": "now",
                                          "emoji": "🍝"
                                        }
                                      },
                                      {
                                        "type": "compute",
                                        "operation": "add",
                                        "key": "totalCalories",
                                        "operands": [
                                          400
                                        ],
                                        "resultKey": "totalCalories"
                                      }
                                    ]
                                  },
                                  "variant": "secondary"
                                }
                              },
                              {
                                "type": "button",
                                "id": "add-banana-btn",
                                "props": {
                                  "label": "🍌 Banana (105)",
                                  "action": {
                                    "type": "batch",
                                    "actions": [
                                      {
                                        "type": "append",
                                        "key": "meals",
                                        "value": {
                                          "name": "Banana",
                                          "calories": 105,
                                          "time": "now",
                                          "emoji": "🍌"
                                        }
                                      },
                                      {
                                        "type": "compute",
                                        "operation": "add",
                                        "key": "totalCalories",
                                        "operands": [
                                          105
                                        ],
                                        "resultKey": "totalCalories"
                                      }
                                    ]
                                  },
                                  "variant": "secondary"
                                }
                              },
                              {
                                "type": "button",
                                "id": "add-protein-btn",
                                "props": {
                                  "label": "🥤 Protein (250)",
                                  "action": {
                                    "type": "batch",
                                    "actions": [
                                      {
                                        "type": "append",
                                        "key": "meals",
                                        "value": {
                                          "name": "Protein Shake",
                                          "calories": 250,
                                          "time": "now",
                                          "emoji": "🥤"
                                        }
                                      },
                                      {
                                        "type": "compute",
                                        "operation": "add",
                                        "key": "totalCalories",
                                        "operands": [
                                          250
                                        ],
                                        "resultKey": "totalCalories"
                                      }
                                    ]
                                  },
                                  "variant": "secondary"
                                }
                              }
                            ],
                            "direction": "row",
                            "gap": 8,
                            "justify": "space-between",
                            "wrap": true
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "spacer-2",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "card",
                    "id": "custom-add-card",
                    "props": {
                      "title": "Custom Entry",
                      "children": [
                        {
                          "type": "input",
                          "id": "meal-name-input",
                          "props": {
                            "placeholder": "Meal name (e.g., Double Cheeseburger)",
                            "stateKey": "newMealName",
                            "inputType": "text"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "spacer-3",
                          "props": {
                            "height": 12
                          }
                        },
                        {
                          "type": "slider",
                          "id": "calories-slider",
                          "props": {
                            "stateKey": "newMealCalories",
                            "min": 50,
                            "max": 1500,
                            "step": 25,
                            "label": "Calories"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "spacer-4",
                          "props": {
                            "height": 12
                          }
                        },
                        {
                          "type": "button",
                          "id": "add-custom-btn",
                          "props": {
                            "label": "Add Meal",
                            "action": {
                              "type": "batch",
                              "actions": [
                                {
                                  "type": "append",
                                  "key": "meals",
                                  "value": {
                                    "name": "",
                                    "calories": 0,
                                    "time": "now",
                                    "emoji": "🍽️"
                                  }
                                },
                                {
                                  "type": "compute",
                                  "operation": "add",
                                  "key": "totalCalories",
                                  "operands": [
                                    0
                                  ],
                                  "resultKey": "totalCalories"
                                },
                                {
                                  "type": "setState",
                                  "key": "newMealName",
                                  "value": ""
                                },
                                {
                                  "type": "setState",
                                  "key": "newMealCalories",
                                  "value": 300
                                }
                              ]
                            },
                            "variant": "primary"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "label": "History",
                "value": "history",
                "children": [
                  {
                    "type": "card",
                    "id": "history-card",
                    "props": {
                      "title": "Recent Meals",
                      "children": [
                        {
                          "type": "list",
                          "id": "meals-list",
                          "props": {
                            "dataKey": "meals",
                            "emptyText": "No meals logged yet. Add your first burger! 🍔",
                            "renderItem": {
                              "components": [
                                {
                                  "type": "container",
                                  "id": "meal-item-container",
                                  "props": {
                                    "children": [
                                      {
                                        "type": "container",
                                        "id": "meal-info",
                                        "props": {
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "meal-emoji",
                                              "props": {
                                                "content": "🍽️",
                                                "variant": "title",
                                                "stateKey": "emoji"
                                              }
                                            },
                                            {
                                              "type": "container",
                                              "id": "meal-details",
                                              "props": {
                                                "children": [
                                                  {
                                                    "type": "text",
                                                    "id": "meal-name",
                                                    "props": {
                                                      "content": "Meal",
                                                      "variant": "body",
                                                      "stateKey": "name"
                                                    }
                                                  },
                                                  {
                                                    "type": "text",
                                                    "id": "meal-calories",
                                                    "props": {
                                                      "content": "0 kcal",
                                                      "variant": "caption",
                                                      "stateKey": "calories"
                                                    }
                                                  }
                                                ],
                                                "direction": "column"
                                              }
                                            }
                                          ],
                                          "direction": "row",
                                          "gap": 12,
                                          "align": "center"
                                        }
                                      },
                                      {
                                        "type": "button",
                                        "id": "delete-meal-btn",
                                        "props": {
                                          "label": "🗑️",
                                          "action": {
                                            "type": "batch",
                                            "actions": [
                                              {
                                                "type": "remove",
                                                "key": "meals",
                                                "index": 0
                                              },
                                              {
                                                "type": "compute",
                                                "operation": "subtract",
                                                "key": "totalCalories",
                                                "operands": [
                                                  0
                                                ],
                                                "resultKey": "totalCalories"
                                              }
                                            ]
                                          },
                                          "variant": "danger"
                                        }
                                      }
                                    ],
                                    "direction": "row",
                                    "padding": 12,
                                    "align": "center",
                                    "justify": "space-between"
                                  }
                                },
                                {
                                  "type": "divider",
                                  "id": "meal-divider",
                                  "props": {
                                    "color": "#333333",
                                    "thickness": 1
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "spacer-5",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "button",
                    "id": "reset-day-btn",
                    "props": {
                      "label": "Reset Today's Log",
                      "action": {
                        "type": "batch",
                        "actions": [
                          {
                            "type": "setState",
                            "key": "meals",
                            "value": []
                          },
                          {
                            "type": "setState",
                            "key": "totalCalories",
                            "value": 0
                          },
                          {
                            "type": "setState",
                            "key": "totalBurgers",
                            "value": 0
                          }
                        ]
                      },
                      "variant": "danger"
                    }
                  }
                ]
              },
              {
                "label": "Stats",
                "value": "stats",
                "children": [
                  {
                    "type": "card",
                    "id": "stats-card",
                    "props": {
                      "title": "Marathon Fuel Stats",
                      "children": [
                        {
                          "type": "container",
                          "id": "stats-grid",
                          "props": {
                            "children": [
                              {
                                "type": "container",
                                "id": "stat-row-1",
                                "props": {
                                  "children": [
                                    {
                                      "type": "container",
                                      "id": "stat-col-1",
                                      "props": {
                                        "children": [
                                          {
                                            "type": "text",
                                            "id": "stat-label-1",
                                            "props": {
                                              "content": "Daily Goal",
                                              "variant": "caption",
                                              "align": "center"
                                            }
                                          },
                                          {
                                            "type": "text",
                                            "id": "stat-value-1",
                                            "props": {
                                              "content": "3500 kcal",
                                              "variant": "subtitle",
                                              "align": "center"
                                            }
                                          }
                                        ],
                                        "direction": "column",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "container",
                                      "id": "stat-col-2",
                                      "props": {
                                        "children": [
                                          {
                                            "type": "text",
                                            "id": "stat-label-2",
                                            "props": {
                                              "content": "Today's Total",
                                              "variant": "caption",
                                              "align": "center"
                                            }
                                          },
                                          {
                                            "type": "text",
                                            "id": "stat-value-2",
                                            "props": {
                                              "content": "0",
                                              "variant": "subtitle",
                                              "align": "center",
                                              "stateKey": "totalCalories"
                                            }
                                          }
                                        ],
                                        "direction": "column",
                                        "align": "center"
                                      }
                                    }
                                  ],
                                  "direction": "row",
                                  "justify": "space-around"
                                }
                              },
                              {
                                "type": "divider",
                                "id": "stat-divider-1",
                                "props": {
                                  "color": "#333333"
                                }
                              },
                              {
                                "type": "container",
                                "id": "burger-stat",
                                "props": {
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "burger-stat-emoji",
                                      "props": {
                                        "content": "🍔",
                                        "variant": "title",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "burger-stat-label",
                                      "props": {
                                        "content": "Burgers Today",
                                        "variant": "caption",
                                        "align": "center"
                                      }
                                    },
                                    {
                                      "type": "text",
                                      "id": "burger-stat-value",
                                      "props": {
                                        "content": "0",
                                        "variant": "title",
                                        "align": "center",
                                        "stateKey": "totalBurgers"
                                      }
                                    }
                                  ],
                                  "direction": "column",
                                  "gap": 8,
                                  "align": "center"
                                }
                              },
                              {
                                "type": "divider",
                                "id": "stat-divider-2",
                                "props": {
                                  "color": "#333333"
                                }
                              },
                              {
                                "type": "text",
                                "id": "tip-text",
                                "props": {
                                  "content": "💡 Tip: Marathon runners need 3000-5000 kcal per day during training. Carbs are your friend!",
                                  "variant": "caption",
                                  "align": "center"
                                }
                              }
                            ],
                            "direction": "column",
                            "gap": 20
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "initialState": {
    "activeTab": "log",
    "totalCalories": 0,
    "totalBurgers": 0,
    "meals": [],
    "newMealName": "",
    "newMealCalories": 300
  },
  "theme": {
    "backgroundColor": "#111118",
    "surfaceColor": "#1e1e2e",
    "primaryColor": "#4f46e5",
    "textColor": "#ffffff",
    "secondaryTextColor": "#888888",
    "borderColor": "#333333",
    "dangerColor": "#dc2626",
    "successColor": "#22c55e"
  }
}