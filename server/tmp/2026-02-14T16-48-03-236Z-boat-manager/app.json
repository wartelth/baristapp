{
  "appId": "boat-manager",
  "title": "Boat Manager",
  "icon": "⛵",
  "version": 1,
  "capabilities": [
    "localStorage"
  ],
  "screens": [
    {
      "id": "home",
      "title": "My Boat",
      "components": [
        {
          "type": "text",
          "id": "welcome-title",
          "props": {
            "content": "⛵ Boat Manager",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "button",
          "id": "maintenance-btn",
          "props": {
            "label": "Maintenance Log",
            "action": {
              "type": "navigate",
              "screenId": "maintenance"
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "trips-btn",
          "props": {
            "label": "Trip Log",
            "action": {
              "type": "navigate",
              "screenId": "trips"
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "expenses-btn",
          "props": {
            "label": "Expenses",
            "action": {
              "type": "navigate",
              "screenId": "expenses"
            },
            "variant": "secondary"
          }
        }
      ]
    },
    {
      "id": "maintenance",
      "title": "Maintenance Log",
      "components": [
        {
          "type": "text",
          "id": "maintenance-header",
          "props": {
            "content": "🔧 Maintenance Records",
            "variant": "title"
          }
        },
        {
          "type": "input",
          "id": "maintenance-task-input",
          "props": {
            "placeholder": "Task (e.g., Oil change)",
            "stateKey": "newMaintenanceTask"
          }
        },
        {
          "type": "input",
          "id": "maintenance-date-input",
          "props": {
            "placeholder": "Date",
            "stateKey": "newMaintenanceDate"
          }
        },
        {
          "type": "button",
          "id": "add-maintenance-btn",
          "props": {
            "label": "Add Record",
            "action": {
              "type": "append",
              "key": "maintenanceRecords"
            },
            "variant": "primary"
          }
        },
        {
          "type": "list",
          "id": "maintenance-list",
          "props": {
            "dataKey": "maintenanceRecords",
            "emptyText": "No maintenance records yet",
            "renderItem": {
              "components": [
                {
                  "type": "text",
                  "id": "maintenance-item-text",
                  "props": {
                    "content": "",
                    "variant": "body",
                    "stateKey": "$item"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "button",
          "id": "back-from-maintenance-btn",
          "props": {
            "label": "← Back",
            "action": {
              "type": "navigate",
              "screenId": "home"
            },
            "variant": "secondary"
          }
        }
      ]
    },
    {
      "id": "trips",
      "title": "Trip Log",
      "components": [
        {
          "type": "text",
          "id": "trips-header",
          "props": {
            "content": "🗺️ Trip Log",
            "variant": "title"
          }
        },
        {
          "type": "input",
          "id": "trip-destination-input",
          "props": {
            "placeholder": "Destination",
            "stateKey": "newTripDestination"
          }
        },
        {
          "type": "input",
          "id": "trip-date-input",
          "props": {
            "placeholder": "Date",
            "stateKey": "newTripDate"
          }
        },
        {
          "type": "input",
          "id": "trip-notes-input",
          "props": {
            "placeholder": "Notes (weather, crew, etc.)",
            "stateKey": "newTripNotes",
            "multiline": true
          }
        },
        {
          "type": "button",
          "id": "add-trip-btn",
          "props": {
            "label": "Log Trip",
            "action": {
              "type": "append",
              "key": "tripRecords"
            },
            "variant": "primary"
          }
        },
        {
          "type": "list",
          "id": "trips-list",
          "props": {
            "dataKey": "tripRecords",
            "emptyText": "No trips logged yet",
            "renderItem": {
              "components": [
                {
                  "type": "text",
                  "id": "trip-item-text",
                  "props": {
                    "content": "",
                    "variant": "body",
                    "stateKey": "$item"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "button",
          "id": "back-from-trips-btn",
          "props": {
            "label": "← Back",
            "action": {
              "type": "navigate",
              "screenId": "home"
            },
            "variant": "secondary"
          }
        }
      ]
    },
    {
      "id": "expenses",
      "title": "Expenses",
      "components": [
        {
          "type": "text",
          "id": "expenses-header",
          "props": {
            "content": "💰 Boat Expenses",
            "variant": "title"
          }
        },
        {
          "type": "input",
          "id": "expense-description-input",
          "props": {
            "placeholder": "Description (e.g., Fuel, Docking)",
            "stateKey": "newExpenseDescription"
          }
        },
        {
          "type": "input",
          "id": "expense-amount-input",
          "props": {
            "placeholder": "Amount",
            "stateKey": "newExpenseAmount",
            "inputType": "number"
          }
        },
        {
          "type": "button",
          "id": "add-expense-btn",
          "props": {
            "label": "Add Expense",
            "action": {
              "type": "append",
              "key": "expenseRecords"
            },
            "variant": "primary"
          }
        },
        {
          "type": "list",
          "id": "expenses-list",
          "props": {
            "dataKey": "expenseRecords",
            "emptyText": "No expenses recorded",
            "renderItem": {
              "components": [
                {
                  "type": "text",
                  "id": "expense-item-text",
                  "props": {
                    "content": "",
                    "variant": "body",
                    "stateKey": "$item"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "button",
          "id": "back-from-expenses-btn",
          "props": {
            "label": "← Back",
            "action": {
              "type": "navigate",
              "screenId": "home"
            },
            "variant": "secondary"
          }
        }
      ]
    }
  ],
  "initialState": {
    "newMaintenanceTask": "",
    "newMaintenanceDate": "",
    "maintenanceRecords": [],
    "newTripDestination": "",
    "newTripDate": "",
    "newTripNotes": "",
    "tripRecords": [],
    "newExpenseDescription": "",
    "newExpenseAmount": "",
    "expenseRecords": []
  }
}