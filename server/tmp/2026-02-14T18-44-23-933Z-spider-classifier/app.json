{
  "appId": "spider-classifier",
  "title": "Spider Classifier",
  "icon": "🕷️",
  "version": 2,
  "capabilities": [
    "localStorage",
    "camera"
  ],
  "screens": [
    {
      "id": "main",
      "title": "Spider Classifier",
      "components": [
        {
          "type": "text",
          "id": "header-title",
          "props": {
            "content": "🕷️ Spider Classifier",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "header-subtitle",
          "props": {
            "content": "Point your camera at a spider to identify it",
            "variant": "caption",
            "align": "center"
          }
        },
        {
          "type": "spacer",
          "id": "spacer-top",
          "props": {
            "height": 12
          }
        },
        {
          "type": "cameraView",
          "id": "spider-camera",
          "props": {
            "stateKey": "photoUri",
            "facing": "back",
            "height": 350,
            "onCapture": {
              "type": "batch",
              "actions": [
                {
                  "type": "setState",
                  "key": "results",
                  "value": []
                },
                {
                  "type": "setState",
                  "key": "classifying",
                  "value": true
                },
                {
                  "type": "serverCall",
                  "endpointId": "classify-spider",
                  "dataKey": "photoUri",
                  "resultKey": "results",
                  "loadingKey": "classifying"
                }
              ]
            }
          }
        },
        {
          "type": "spacer",
          "id": "spacer-mid",
          "props": {
            "height": 12
          }
        },
        {
          "type": "card",
          "id": "preview-card",
          "props": {
            "title": "📸 Captured Photo",
            "children": [
              {
                "type": "image",
                "id": "photo-preview",
                "props": {
                  "stateKey": "photoUri",
                  "height": 200,
                  "resizeMode": "contain"
                }
              }
            ]
          },
          "visibleWhen": {
            "stateKey": "photoUri",
            "operator": "truthy"
          }
        },
        {
          "type": "container",
          "id": "loading-container",
          "props": {
            "children": [
              {
                "type": "progress",
                "id": "classify-progress",
                "props": {
                  "stateKey": "classifying",
                  "variant": "bar",
                  "color": "#7c3aed",
                  "label": "🔬 Analyzing spider...",
                  "height": 8
                }
              },
              {
                "type": "text",
                "id": "loading-text",
                "props": {
                  "content": "Identifying species...",
                  "variant": "caption",
                  "align": "center"
                }
              }
            ],
            "direction": "column",
            "gap": 8,
            "padding": 16,
            "align": "center"
          },
          "visibleWhen": {
            "stateKey": "classifying",
            "operator": "truthy"
          }
        },
        {
          "type": "card",
          "id": "results-card",
          "props": {
            "title": "🔍 Identification Results",
            "children": [
              {
                "type": "list",
                "id": "results-list",
                "props": {
                  "dataKey": "results",
                  "emptyText": "Take a photo to identify a spider",
                  "renderItem": {
                    "components": [
                      {
                        "type": "card",
                        "id": "result-item-card",
                        "props": {
                          "children": [
                            {
                              "type": "container",
                              "id": "result-row",
                              "props": {
                                "children": [
                                  {
                                    "type": "text",
                                    "id": "result-label",
                                    "props": {
                                      "content": "",
                                      "variant": "subtitle",
                                      "stateKey": "label"
                                    }
                                  },
                                  {
                                    "type": "text",
                                    "id": "result-score",
                                    "props": {
                                      "content": "",
                                      "variant": "caption",
                                      "stateKey": "score"
                                    }
                                  }
                                ],
                                "direction": "row",
                                "padding": 4,
                                "align": "center",
                                "justify": "space-between"
                              }
                            }
                          ],
                          "elevation": 1
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "visibleWhen": {
            "stateKey": "photoUri",
            "operator": "truthy"
          }
        },
        {
          "type": "spacer",
          "id": "spacer-bottom",
          "props": {
            "height": 8
          }
        },
        {
          "type": "button",
          "id": "reset-btn",
          "props": {
            "label": "🔄 New Scan",
            "action": {
              "type": "batch",
              "actions": [
                {
                  "type": "setState",
                  "key": "photoUri",
                  "value": null
                },
                {
                  "type": "setState",
                  "key": "results",
                  "value": []
                },
                {
                  "type": "setState",
                  "key": "classifying",
                  "value": false
                }
              ]
            },
            "variant": "secondary"
          },
          "visibleWhen": {
            "stateKey": "photoUri",
            "operator": "truthy"
          }
        },
        {
          "type": "spacer",
          "id": "spacer-info",
          "props": {
            "height": 8
          }
        },
        {
          "type": "button",
          "id": "info-btn",
          "props": {
            "label": "ℹ️ Safety Tips",
            "action": {
              "type": "setState",
              "key": "showInfo",
              "value": true
            },
            "variant": "secondary"
          }
        },
        {
          "type": "modal",
          "id": "info-modal",
          "props": {
            "visibleKey": "showInfo",
            "title": "🕷️ Spider Safety Tips",
            "children": [
              {
                "type": "text",
                "id": "tip-1",
                "props": {
                  "content": "⚠️ Never handle an unidentified spider",
                  "variant": "body"
                }
              },
              {
                "type": "spacer",
                "id": "tip-spacer-1",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "text",
                "id": "tip-2",
                "props": {
                  "content": "📏 Keep a safe distance when photographing",
                  "variant": "body"
                }
              },
              {
                "type": "spacer",
                "id": "tip-spacer-2",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "text",
                "id": "tip-3",
                "props": {
                  "content": "🏥 If bitten, seek medical attention and try to photograph the spider",
                  "variant": "body"
                }
              },
              {
                "type": "spacer",
                "id": "tip-spacer-3",
                "props": {
                  "height": 8
                }
              },
              {
                "type": "text",
                "id": "tip-4",
                "props": {
                  "content": "🤖 AI classification is not 100% accurate — always consult an expert for dangerous species",
                  "variant": "caption"
                }
              },
              {
                "type": "spacer",
                "id": "tip-spacer-4",
                "props": {
                  "height": 16
                }
              },
              {
                "type": "button",
                "id": "close-info-btn",
                "props": {
                  "label": "Got It",
                  "action": {
                    "type": "setState",
                    "key": "showInfo",
                    "value": false
                  },
                  "variant": "primary"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "initialState": {
    "photoUri": null,
    "results": [],
    "classifying": false,
    "showInfo": false,
    "selectedResult": null
  },
  "theme": {
    "backgroundColor": "#111118",
    "surfaceColor": "#1e1e2e",
    "primaryColor": "#7c3aed",
    "textColor": "#ffffff",
    "secondaryTextColor": "#a0a0b0",
    "borderColor": "#333333",
    "dangerColor": "#dc2626",
    "successColor": "#22c55e"
  },
  "serverEndpoints": [
    {
      "id": "classify-spider",
      "method": "POST",
      "processing": {
        "type": "huggingface",
        "model": "google/vit-base-patch16-224",
        "task": "image-classification"
      }
    }
  ]
}