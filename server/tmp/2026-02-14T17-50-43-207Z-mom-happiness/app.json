{
  "appId": "mom-happiness",
  "title": "Love You Mom",
  "icon": "💐",
  "version": 1,
  "capabilities": [
    "localStorage"
  ],
  "screens": [
    {
      "id": "home",
      "title": "💖 For Mom",
      "components": [
        {
          "type": "text",
          "id": "greeting",
          "props": {
            "content": "Hi Mom! 💕",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "subtitle",
          "props": {
            "content": "Here are some reasons you're amazing:",
            "variant": "subtitle",
            "align": "center"
          }
        },
        {
          "type": "list",
          "id": "reasons-list",
          "props": {
            "dataKey": "reasons",
            "emptyText": "Add your first reason below!",
            "renderItem": {
              "components": [
                {
                  "type": "text",
                  "id": "reason-text",
                  "props": {
                    "content": "",
                    "variant": "body",
                    "stateKey": "$item"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "input",
          "id": "new-reason-input",
          "props": {
            "placeholder": "Add another reason...",
            "stateKey": "newReason",
            "multiline": true,
            "inputType": "text"
          }
        },
        {
          "type": "button",
          "id": "add-reason-btn",
          "props": {
            "label": "Add Reason",
            "action": {
              "type": "append",
              "key": "reasons",
              "fromKey": "newReason"
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "show-message-btn",
          "props": {
            "label": "See Special Message",
            "action": {
              "type": "navigate",
              "screenId": "message"
            },
            "variant": "secondary"
          }
        }
      ]
    },
    {
      "id": "message",
      "title": "Special Message",
      "components": [
        {
          "type": "text",
          "id": "message-title",
          "props": {
            "content": "You Mean The World To Me",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "message-body",
          "props": {
            "content": "Thank you for everything you do. Your love, support, and kindness make every day brighter. I'm so grateful to have you as my mom. I love you more than words can say! 💕",
            "variant": "body",
            "align": "center"
          }
        },
        {
          "type": "button",
          "id": "back-btn",
          "props": {
            "label": "Back Home",
            "action": {
              "type": "navigate",
              "screenId": "home"
            },
            "variant": "primary"
          }
        }
      ]
    }
  ],
  "initialState": {
    "newReason": "",
    "reasons": [
      "🌟 You always know how to make me smile",
      "💪 You're the strongest person I know",
      "🏠 You make our house a home",
      "❤️ Your hugs are the best medicine"
    ]
  }
}