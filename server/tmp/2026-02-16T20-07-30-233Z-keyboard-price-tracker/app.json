{
  "appId": "keyboard-price-tracker",
  "title": "Keyboard Price Tracker",
  "icon": "⌨️",
  "version": 2,
  "capabilities": [
    "localStorage",
    "network",
    "haptics",
    "clipboard"
  ],
  "screens": [
    {
      "id": "main",
      "title": "Keyboard Price Tracker",
      "components": [
        {
          "type": "tabs",
          "id": "main-tabs",
          "props": {
            "stateKey": "activeTab",
            "tabs": [
              {
                "label": "📊 Dashboard",
                "value": "dashboard",
                "children": [
                  {
                    "type": "container",
                    "id": "stats-row",
                    "props": {
                      "children": [
                        {
                          "type": "card",
                          "id": "stat-tracking",
                          "props": {
                            "children": [
                              {
                                "type": "text",
                                "id": "stat-tracking-label",
                                "props": {
                                  "content": "Tracking",
                                  "variant": "caption",
                                  "align": "center"
                                }
                              },
                              {
                                "type": "text",
                                "id": "stat-tracking-value",
                                "props": {
                                  "content": "0",
                                  "variant": "title",
                                  "align": "center",
                                  "stateKey": "totalTracking"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "type": "card",
                          "id": "stat-drops",
                          "props": {
                            "children": [
                              {
                                "type": "text",
                                "id": "stat-drops-label",
                                "props": {
                                  "content": "Price Drops",
                                  "variant": "caption",
                                  "align": "center"
                                }
                              },
                              {
                                "type": "text",
                                "id": "stat-drops-value",
                                "props": {
                                  "content": "0",
                                  "variant": "title",
                                  "align": "center",
                                  "stateKey": "totalDrops"
                                }
                              }
                            ]
                          }
                        }
                      ],
                      "direction": "row",
                      "gap": 10,
                      "padding": 8
                    }
                  },
                  {
                    "type": "card",
                    "id": "best-deal-card",
                    "props": {
                      "title": "🔥 Best Deal Right Now",
                      "children": [
                        {
                          "type": "text",
                          "id": "best-deal-text",
                          "props": {
                            "content": "No deals yet",
                            "variant": "body",
                            "stateKey": "bestDeal"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "card",
                    "id": "price-chart-card",
                    "props": {
                      "title": "📈 Price Trend (7 Days)",
                      "children": [
                        {
                          "type": "chart",
                          "id": "price-chart",
                          "props": {
                            "chartType": "line",
                            "dataKey": "priceHistory",
                            "xKey": "label",
                            "yKey": "value",
                            "height": 200,
                            "color": "#6366f1"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "dash-spacer",
                    "props": {
                      "height": 12
                    }
                  },
                  {
                    "type": "text",
                    "id": "watched-heading",
                    "props": {
                      "content": "Watched Keyboards",
                      "variant": "subtitle"
                    }
                  },
                  {
                    "type": "list",
                    "id": "keyboard-list",
                    "props": {
                      "dataKey": "keyboards",
                      "emptyText": "No keyboards tracked yet. Add one below!",
                      "renderItem": {
                        "components": [
                          {
                            "type": "card",
                            "id": "kb-item-card",
                            "props": {
                              "children": [
                                {
                                  "type": "container",
                                  "id": "kb-item-row",
                                  "props": {
                                    "children": [
                                      {
                                        "type": "container",
                                        "id": "kb-item-info",
                                        "props": {
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "kb-item-name",
                                              "props": {
                                                "content": "",
                                                "variant": "body",
                                                "stateKey": "name"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "kb-item-range",
                                              "props": {
                                                "content": "Low / High range",
                                                "variant": "caption"
                                              }
                                            }
                                          ],
                                          "direction": "column",
                                          "gap": 4
                                        }
                                      },
                                      {
                                        "type": "container",
                                        "id": "kb-item-price-col",
                                        "props": {
                                          "children": [
                                            {
                                              "type": "text",
                                              "id": "kb-item-price",
                                              "props": {
                                                "content": "$0",
                                                "variant": "subtitle",
                                                "stateKey": "currentPrice"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "id": "kb-item-status",
                                              "props": {
                                                "content": "",
                                                "variant": "caption",
                                                "stateKey": "status"
                                              }
                                            }
                                          ],
                                          "direction": "column",
                                          "gap": 2,
                                          "align": "flex-end"
                                        }
                                      }
                                    ],
                                    "direction": "row",
                                    "align": "center",
                                    "justify": "space-between"
                                  }
                                }
                              ],
                              "elevation": 1,
                              "onPress": {
                                "type": "batch",
                                "actions": [
                                  {
                                    "type": "setState",
                                    "key": "selectedKeyboard",
                                    "value": ""
                                  },
                                  {
                                    "type": "setState",
                                    "key": "showDetailModal",
                                    "value": true
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "label": "➕ Add",
                "value": "add",
                "children": [
                  {
                    "type": "card",
                    "id": "add-card",
                    "props": {
                      "title": "Add Keyboard to Track",
                      "children": [
                        {
                          "type": "text",
                          "id": "add-instructions",
                          "props": {
                            "content": "Paste a product URL from a retailer and we'll start tracking the price automatically.",
                            "variant": "caption"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "add-spacer-1",
                          "props": {
                            "height": 12
                          }
                        },
                        {
                          "type": "input",
                          "id": "add-name-input",
                          "props": {
                            "placeholder": "Keyboard name (e.g., Keychron V6)",
                            "stateKey": "newKeyboardName"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "add-spacer-2",
                          "props": {
                            "height": 8
                          }
                        },
                        {
                          "type": "input",
                          "id": "add-url-input",
                          "props": {
                            "placeholder": "Product URL (Amazon, manufacturer, etc.)",
                            "stateKey": "newKeyboardUrl"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "add-spacer-3",
                          "props": {
                            "height": 12
                          }
                        },
                        {
                          "type": "button",
                          "id": "add-btn",
                          "props": {
                            "label": "🔍 Check Price & Add",
                            "action": {
                              "type": "batch",
                              "actions": [
                                {
                                  "type": "http",
                                  "url": "https://api.allorigins.win/get?url={{newKeyboardUrl}}",
                                  "method": "GET",
                                  "resultKey": "checkResult",
                                  "loadingKey": "checking",
                                  "errorKey": "checkError"
                                },
                                {
                                  "type": "append",
                                  "key": "keyboards",
                                  "value": {
                                    "id": "new",
                                    "name": "New Keyboard",
                                    "url": "",
                                    "currentPrice": 0,
                                    "lowestPrice": 0,
                                    "highestPrice": 0,
                                    "lastChecked": "2026-02-16",
                                    "priceChange": 0,
                                    "status": "new"
                                  }
                                },
                                {
                                  "type": "compute",
                                  "operation": "increment",
                                  "key": "totalTracking"
                                },
                                {
                                  "type": "setState",
                                  "key": "newKeyboardName",
                                  "value": ""
                                },
                                {
                                  "type": "setState",
                                  "key": "newKeyboardUrl",
                                  "value": ""
                                },
                                {
                                  "type": "haptic",
                                  "style": "success"
                                }
                              ]
                            },
                            "variant": "primary"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "add-spacer-4",
                          "props": {
                            "height": 8
                          }
                        },
                        {
                          "type": "progress",
                          "id": "checking-bar",
                          "props": {
                            "stateKey": "checking",
                            "variant": "bar",
                            "color": "#6366f1",
                            "label": "Checking price..."
                          },
                          "visibleWhen": {
                            "stateKey": "checking",
                            "operator": "truthy"
                          }
                        },
                        {
                          "type": "text",
                          "id": "check-error-text",
                          "props": {
                            "content": "Could not fetch price. You can still track manually.",
                            "variant": "caption"
                          },
                          "visibleWhen": {
                            "stateKey": "checkError",
                            "operator": "truthy"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "add-bottom-spacer",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "card",
                    "id": "supported-sites-card",
                    "props": {
                      "title": "Supported Retailers",
                      "children": [
                        {
                          "type": "text",
                          "id": "supported-text",
                          "props": {
                            "content": "🛒 Amazon  •  ⌨️ Keychron  •  🏪 MechanicalKeyboards.com  •  🎮 Drop  •  🌐 AliExpress  •  Any product URL",
                            "variant": "caption"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "label": "⚙️ Settings",
                "value": "settings",
                "children": [
                  {
                    "type": "card",
                    "id": "alert-settings-card",
                    "props": {
                      "title": "Price Alerts",
                      "children": [
                        {
                          "type": "toggle",
                          "id": "alerts-toggle",
                          "props": {
                            "stateKey": "alertsEnabled",
                            "label": "Enable price drop alerts"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "settings-spacer-1",
                          "props": {
                            "height": 12
                          }
                        },
                        {
                          "type": "slider",
                          "id": "threshold-slider",
                          "props": {
                            "stateKey": "alertThreshold",
                            "min": 1,
                            "max": 50,
                            "step": 1,
                            "label": "Alert when price drops by ($)"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "card",
                    "id": "check-freq-card",
                    "props": {
                      "title": "Check Frequency",
                      "children": [
                        {
                          "type": "select",
                          "id": "freq-select",
                          "props": {
                            "stateKey": "checkFrequency",
                            "options": [
                              {
                                "label": "Every hour",
                                "value": "1h"
                              },
                              {
                                "label": "Every 6 hours",
                                "value": "6h"
                              },
                              {
                                "label": "Every 12 hours",
                                "value": "12h"
                              },
                              {
                                "label": "Once a day",
                                "value": "24h"
                              }
                            ],
                            "placeholder": "Select frequency..."
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "spacer",
                    "id": "settings-spacer-2",
                    "props": {
                      "height": 16
                    }
                  },
                  {
                    "type": "card",
                    "id": "actions-card",
                    "props": {
                      "title": "Actions",
                      "children": [
                        {
                          "type": "button",
                          "id": "refresh-all-btn",
                          "props": {
                            "label": "🔄 Refresh All Prices Now",
                            "action": {
                              "type": "batch",
                              "actions": [
                                {
                                  "type": "haptic",
                                  "style": "medium"
                                },
                                {
                                  "type": "setState",
                                  "key": "checking",
                                  "value": true
                                },
                                {
                                  "type": "setState",
                                  "key": "checking",
                                  "value": false
                                }
                              ]
                            },
                            "variant": "primary"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "actions-spacer",
                          "props": {
                            "height": 8
                          }
                        },
                        {
                          "type": "button",
                          "id": "export-btn",
                          "props": {
                            "label": "📋 Copy Price Data",
                            "action": {
                              "type": "copyToClipboard",
                              "value": "Keyboard Price Tracker — Export Data\nKeychron Q1 Pro: $189.99 (Low: $169.99)\nHHKB Professional Hybrid: $269.00 (Low: $249.00)\nZoom65 V3: $149.00 (Low: $129.00)"
                            },
                            "variant": "secondary"
                          }
                        },
                        {
                          "type": "spacer",
                          "id": "actions-spacer-2",
                          "props": {
                            "height": 8
                          }
                        },
                        {
                          "type": "button",
                          "id": "clear-btn",
                          "props": {
                            "label": "🗑️ Clear All Data",
                            "action": {
                              "type": "batch",
                              "actions": [
                                {
                                  "type": "setState",
                                  "key": "keyboards",
                                  "value": []
                                },
                                {
                                  "type": "setState",
                                  "key": "priceHistory",
                                  "value": []
                                },
                                {
                                  "type": "setState",
                                  "key": "totalTracking",
                                  "value": 0
                                },
                                {
                                  "type": "setState",
                                  "key": "totalDrops",
                                  "value": 0
                                },
                                {
                                  "type": "setState",
                                  "key": "bestDeal",
                                  "value": "No deals yet"
                                },
                                {
                                  "type": "haptic",
                                  "style": "warning"
                                }
                              ]
                            },
                            "variant": "danger"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "initialState": {
    "activeTab": "dashboard",
    "keyboards": [
      {
        "id": "1",
        "name": "Keychron Q1 Pro",
        "url": "https://www.keychron.com/products/keychron-q1-pro",
        "currentPrice": 189.99,
        "lowestPrice": 169.99,
        "highestPrice": 199.99,
        "lastChecked": "2026-02-16T10:30:00Z",
        "priceChange": -5,
        "status": "dropped"
      },
      {
        "id": "2",
        "name": "HHKB Professional Hybrid",
        "url": "https://hhkeyboard.us/hhkb/pro-hybrid",
        "currentPrice": 269,
        "lowestPrice": 249,
        "highestPrice": 299,
        "lastChecked": "2026-02-16T10:30:00Z",
        "priceChange": 0,
        "status": "stable"
      },
      {
        "id": "3",
        "name": "Zoom65 V3",
        "url": "https://meletrix.com/products/zoom65-v3",
        "currentPrice": 149,
        "lowestPrice": 129,
        "highestPrice": 159,
        "lastChecked": "2026-02-16T10:28:00Z",
        "priceChange": 10,
        "status": "increased"
      }
    ],
    "priceHistory": [
      {
        "label": "Feb 10",
        "value": 195
      },
      {
        "label": "Feb 11",
        "value": 192
      },
      {
        "label": "Feb 12",
        "value": 189
      },
      {
        "label": "Feb 13",
        "value": 185
      },
      {
        "label": "Feb 14",
        "value": 189
      },
      {
        "label": "Feb 15",
        "value": 185
      },
      {
        "label": "Feb 16",
        "value": 189
      }
    ],
    "totalTracking": 3,
    "totalDrops": 1,
    "bestDeal": "Keychron Q1 Pro — $189.99 (↓$5.00)",
    "newKeyboardName": "",
    "newKeyboardUrl": "",
    "checkUrl": "",
    "showAddModal": false,
    "showDetailModal": false,
    "selectedKeyboard": "",
    "selectedPrice": "",
    "selectedLow": "",
    "selectedHigh": "",
    "selectedChange": "",
    "selectedUrl": "",
    "checking": false,
    "checkResult": null,
    "checkError": null,
    "alertsEnabled": true,
    "alertThreshold": 10,
    "checkFrequency": "6h"
  },
  "theme": {
    "backgroundColor": "#111118",
    "surfaceColor": "#1a1a2e",
    "primaryColor": "#6366f1",
    "textColor": "#f0f0f0",
    "secondaryTextColor": "#8888aa",
    "borderColor": "#2a2a3e",
    "dangerColor": "#ef4444",
    "successColor": "#22c55e"
  },
  "effects": [
    {
      "trigger": "onMount",
      "action": {
        "type": "batch",
        "actions": [
          {
            "type": "compute",
            "operation": "length",
            "key": "keyboards",
            "resultKey": "totalTracking"
          }
        ]
      }
    }
  ]
}