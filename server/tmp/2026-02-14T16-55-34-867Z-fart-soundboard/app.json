{
  "appId": "fart-soundboard",
  "title": "Fart Sounds",
  "icon": "💨",
  "version": 1,
  "capabilities": [
    "localStorage"
  ],
  "screens": [
    {
      "id": "main",
      "title": "Fart Soundboard",
      "components": [
        {
          "type": "text",
          "id": "title",
          "props": {
            "content": "💨 Ultimate Fart Soundboard 💨",
            "variant": "title",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "subtitle",
          "props": {
            "content": "Tap a button to play a sound!",
            "variant": "subtitle",
            "align": "center"
          }
        },
        {
          "type": "button",
          "id": "classic-btn",
          "props": {
            "label": "💨 Classic Toot",
            "action": {
              "type": "setState",
              "key": "lastPlayed",
              "value": "Classic Toot"
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "squeaker-btn",
          "props": {
            "label": "🎵 Squeaker",
            "action": {
              "type": "setState",
              "key": "lastPlayed",
              "value": "Squeaker"
            },
            "variant": "secondary"
          }
        },
        {
          "type": "button",
          "id": "thunder-btn",
          "props": {
            "label": "⚡ Thunder Clap",
            "action": {
              "type": "setState",
              "key": "lastPlayed",
              "value": "Thunder Clap"
            },
            "variant": "danger"
          }
        },
        {
          "type": "button",
          "id": "trumpet-btn",
          "props": {
            "label": "🎺 Trumpet",
            "action": {
              "type": "setState",
              "key": "lastPlayed",
              "value": "Trumpet"
            },
            "variant": "primary"
          }
        },
        {
          "type": "button",
          "id": "rapid-btn",
          "props": {
            "label": "🔥 Rapid Fire",
            "action": {
              "type": "setState",
              "key": "lastPlayed",
              "value": "Rapid Fire"
            },
            "variant": "secondary"
          }
        },
        {
          "type": "button",
          "id": "long-btn",
          "props": {
            "label": "⏱️ Long & Loud",
            "action": {
              "type": "setState",
              "key": "lastPlayed",
              "value": "Long & Loud"
            },
            "variant": "danger"
          }
        },
        {
          "type": "text",
          "id": "status",
          "props": {
            "content": "Last played: ",
            "variant": "body",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "last-played",
          "props": {
            "content": "",
            "variant": "subtitle",
            "align": "center",
            "stateKey": "lastPlayed"
          }
        },
        {
          "type": "text",
          "id": "counter-label",
          "props": {
            "content": "Total farts: ",
            "variant": "caption",
            "align": "center"
          }
        },
        {
          "type": "text",
          "id": "counter",
          "props": {
            "content": "0",
            "variant": "body",
            "align": "center",
            "stateKey": "totalPlayed"
          }
        }
      ]
    }
  ],
  "initialState": {
    "lastPlayed": "None yet!",
    "totalPlayed": 0
  }
}