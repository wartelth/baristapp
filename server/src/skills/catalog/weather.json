{
  "id": "weather",
  "name": "Weather",
  "description": "Get current weather and forecasts for any location using Open-Meteo",
  "category": "weather",
  "capability": "network",
  "rateLimit": { "requests": 60, "windowMs": 60000 },
  "provider": {
    "baseUrl": "https://api.open-meteo.com/v1",
    "authType": "none"
  },
  "actions": {
    "current": {
      "description": "Get current weather conditions for a latitude/longitude",
      "endpoint": "/forecast?latitude={{lat}}&longitude={{lon}}&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,wind_direction_10m&temperature_unit=celsius",
      "method": "GET",
      "params": {
        "lat": { "type": "number", "required": true, "description": "Latitude (-90 to 90)" },
        "lon": { "type": "number", "required": true, "description": "Longitude (-180 to 180)" }
      },
      "transform": "current",
      "cacheTtlMs": 300000
    },
    "forecast": {
      "description": "Get daily weather forecast for up to 7 days",
      "endpoint": "/forecast?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,weather_code,precipitation_sum,wind_speed_10m_max&temperature_unit=celsius&forecast_days={{days}}",
      "method": "GET",
      "params": {
        "lat": { "type": "number", "required": true, "description": "Latitude" },
        "lon": { "type": "number", "required": true, "description": "Longitude" },
        "days": { "type": "number", "required": false, "description": "Number of forecast days (1-7)", "default": 7 }
      },
      "transform": "daily",
      "cacheTtlMs": 600000
    },
    "hourly": {
      "description": "Get hourly weather forecast for the next 24 hours",
      "endpoint": "/forecast?latitude={{lat}}&longitude={{lon}}&hourly=temperature_2m,weather_code,precipitation_probability,wind_speed_10m&temperature_unit=celsius&forecast_hours=24",
      "method": "GET",
      "params": {
        "lat": { "type": "number", "required": true, "description": "Latitude" },
        "lon": { "type": "number", "required": true, "description": "Longitude" }
      },
      "transform": "hourly",
      "cacheTtlMs": 300000
    }
  }
}
